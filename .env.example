# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<pass>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
DB_NAME=purerise

# ─── JWT Secrets ──────────────────────────────────────────────────────────────
ACCESS_TOKEN_SECRET=change_me_in_production
REFRESH_TOKEN_SECRET=change_me_in_production

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── SMTP / Email (Gmail via App Password) ───────────────────────────────────
# To obtain a Gmail App Password:
#   1. Enable 2-Step Verification on your Google account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create a new App Password and paste it below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false          # set to true only for port 465
SMTP_USER=adminpureraise@gmail.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD_HERE

EMAIL_FROM_NAME=PureRaise
EMAIL_FROM_ADDRESS=adminpureraise@gmail.com
